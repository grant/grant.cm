{
  "name": "grant.cm",
  "version": "1.0.0",
  "description": "The home page for grant.cm",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grant/grant.cm"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-8080}",
    "lint": "gts lint",
    "clean": "gts clean",
    "fix": "gts fix",
    "deploy": "RUN_ENV=PROD ./deploy.sh",
    "stage": "./deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gts": "^6.0.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
